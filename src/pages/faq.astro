---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, FAQS } from '../data/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title={`よくある質問｜${SITE.name}`}
  description="ゲームポイ活・紹介コードのよくある質問6件。ゲームポイ活とは何か、Freecashやポケカツのコードの使い方、特典が無料でもらえるかなど。"
  canonicalPath="/faq/"
  jsonLd={jsonLd}
>
  <div class="wrap">
    <p class="breadcrumb"><a href="/mea-game-poikatsu/">トップ</a> › よくある質問</p>
    <h1>よくある質問｜ゲームポイ活・紹介コードの疑問</h1>
    {FAQS.map((f) => (
      <div class="faq-item">
        <h3>{f.q}</h3>
        <p>{f.a}</p>
      </div>
    ))}
    <p><a href="/mea-game-poikatsu/">クエスト一覧トップへ戻る →</a></p>
  </div>
</BaseLayout>
